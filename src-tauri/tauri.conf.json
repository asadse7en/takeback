{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Takeback",
  "version": "0.1.0",
  "identifier": "com.example.takeback",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Takeback",
        "width": 1100,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/exiftool"
    ],
    "windows": {
      "nsis": {
        "headerImage": "installer/windows/nsis-header.bmp",
        "sidebarImage": "installer/windows/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/windows/wix-banner.bmp",
        "dialogImagePath": "installer/windows/wix-dialog.bmp"
      }
    },
    "macOS": {
      "dmg": {
        "background": "installer/macos/dmg-background.png"
      }
    }
  }
}
